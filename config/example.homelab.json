  "jobs": [
    {
      "id": "vzdump-pve1",
      "name": "Guest backups · pve1",
      "group": "backup",
      "family": "Proxmox guests → NAS",
      "short": "pve1",
      "where": "pve1 → NAS",
      "schedule": "nightly 02:00",
      "maxAgeH": 30,
      "signal": "proxmox-vzdump",
      "node": "pve1"
    },
    {
      "id": "vzdump-pve2",
      "name": "Guest backups · pve2",
      "group": "backup",
      "family": "Proxmox guests → NAS",
      "short": "pve2",
      "where": "pve2 → NAS",
      "schedule": "nightly 03:00",
      "maxAgeH": 30,
      "signal": "proxmox-vzdump",
      "node": "pve2"
    },
    {
      "id": "kopia",
      "name": "Kopia off-site",
      "group": "backup",
      "where": "NAS → off-site storage",
      "schedule": "daily 05:00",
      "maxAgeH": 30,
      "signal": "prometheus",
      "last": "kopia_snapshot_last_success_timestamp_seconds"
    },
    {
      "id": "health-report",
      "name": "Health report",
      "group": "automation",
      "where": "monitoring → ntfy",
      "schedule": "daily 08:00",
      "maxAgeH": 26,
      "signal": "ntfy",
      "topic": "lab-status"
    },
    {
      "id": "host-config",
      "name": "Host config backup",
      "group": "backup",
      "where": "pve1 → NAS",
      "schedule": "weekly, Sun 03:00",
      "maxAgeH": 0,
      "signal": "none",
      "note": "log only; needs a textfile metric"
    }
