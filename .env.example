# Copy to .env (chmod 600). Every key should be read-only, and all of them stay on the server: the page never sees one.
# A module whose key is missing is off (or "not connected" when homelab.json lists it in `modules`). Nothing crashes.

# Prometheus: node_exporter hosts, cAdvisor, exporters, jobs (modules prometheus, network, the *arr exporters, homeassistant, ups, unraid, apt, edge)
PROMETHEUS_URL=

# Proxmox: one read-only API token (PVEAuditor) per node. The prefix is PVE_<HOST ID> (host id 'pve1' → PVE_PVE1),
# or the host's `tokenEnv` in homelab.json. Token id looks like user@realm!tokenname.
PVE_PVE1_TOKEN_ID=
PVE_PVE1_TOKEN_SECRET=

# Uptime Kuma: Settings → API Keys (read-only /metrics)
KUMA_URL=
KUMA_API_KEY=

# Grafana: firing, unsilenced alerts. A service account with the Viewer role → Add token.
GRAFANA_URL=
GRAFANA_TOKEN=

# ntfy: health needs no auth; the notification feed needs a read-only user's token and the topics, comma-separated.
NTFY_URL=
NTFY_TOKEN=
NTFY_TOPICS=

# Media apps (each needs its URL and key)
TAUTULLI_URL=
TAUTULLI_KEY=
PLEX_URL=
PLEX_TOKEN=
BAZARR_URL=
BAZARR_KEY=
SEERR_URL=
SEERR_KEY=
PROWLARR_URL=
PROWLARR_KEY=
CHAPTARR_URL=
CHAPTARR_KEY=
IMMICH_URL=
IMMICH_KEY=

# WUD (container updates): a login that can read /api/containers
WUD_URL=
WUD_USER=
WUD_PASSWORD=

# Login, once per device (off while CC_LOGIN_BCRYPT is empty): the password's bcrypt hash, and a random secret that
# signs the cookie (without it every device signs in again after a restart; changing it signs every device out).
CC_LOGIN_BCRYPT=
CC_SESSION_SECRET=
# CC_LOGIN_USER=admin        # the name password managers save it under
# CC_COOKIE_SECURE=0         # only when serving over plain HTTP
# CC_TRUST_PROXY=1           # rate-limit by X-Forwarded-For (only when a reverse proxy is the only way in)

# Optional
# HOMELAB_CONFIG=config/homelab.json
# DATA_DIR=data
# PORT=8787
# PROBES=off                 # don't probe publicEndpoints
# WEATHER=off
# DEVICES_FILE=/app/inbox/devices.json
# MAC_PROBE_PORT=22
# ALLOW_SIMULATE=1           # ?simulateIncident=1 in production
# CC_FETCH=curl              # macOS: fetch through /usr/bin/curl (Local Network privacy)
